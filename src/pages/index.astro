---
import Layout from '~/layouts/PageLayout.astro';

import FeatureCards from '~/components/widgets/FeatureCards.astro';
import Features from '~/components/widgets/Features.astro';
import BlogLatestPosts from '~/components/widgets/BlogLatestPosts.astro';
import FAQs from '~/components/widgets/FAQs.astro';
import Hero2 from '~/components/widgets/Hero2.astro';
import { getPermalink } from '~/utils/permalinks';

const faqs = [
  {
    title: 'What is Sketch Nomad?',
    description:
      'Sketch Nomad is a free platform for urban sketchers, plein air painters, outdoor artists, and travel sketchers. Tag your artwork to a place, keep a map of your sketching spots, and connect with a worldwide outdoor-art community.',
  },
  {
    title: 'What is plein air (or pleinair) painting?',
    description:
      'Plein air — also written pleinair or en plein air — means painting or sketching outdoors, from life. Sketch Nomad is built for that practice: location-tagged sketches, discovery maps, and sketch-together sessions in the field.',
  },
  {
    title: 'Is Sketch Nomad for urban sketchers?',
    description:
      'Yes. Urban sketchers who draw cities, streets, and daily life on location can pin sketches to the exact spot, find fellow sketchers nearby, and join sketch-together sessions.',
  },
  {
    title: 'Can travel sketchers use it?',
    description:
      'Travel sketchers can log sketches from trains, cafés, trails, and cities they visit, then look back at a map of every place they drew. It is a visual travel journal as much as a community.',
  },
  {
    title: 'Is this for professional outdoor artists only?',
    description:
      "Not at all. Sketch Nomad is for every outdoor artist — seasoned plein air painters, weekend hobbyists, urban sketchers, nature journalers, and anyone just starting.",
  },
  {
    title: 'How does location tagging work?',
    description:
      'When you upload a piece, you can attach the GPS location where you created it. That builds a personal map of your spots and, if you choose, helps other artists discover new places to paint or sketch.',
  },
  {
    title: 'What is your stance on AI and artist data?',
    description:
      'Your art and data are yours, period. We will never use your artwork to train AI models. We are committed to being a trusted, private space for artists to share their work without worry.',
  },
  {
    title: 'Is Sketch Nomad free?',
    description:
      'Yes. The web app is free to use. We plan to always offer a free version so outdoor artists can create without a financial barrier.',
  },
];

const metadata = {
  title: 'Sketch Nomad – Urban Sketchers, Plein Air & Outdoor Artists',
  description:
    'A community for urban sketchers, plein air painters, outdoor artists, and travel sketchers. Tag sketches to a place, find pleinair spots, and connect worldwide.',
  keywords:
    'urban sketchers, urban sketching, plein air, pleinair, en plein air, outdoor artist, outdoor artists, travel sketcher, travel sketching, plein air painting, outdoor sketching',
  ignoreTitleTemplate: true,
};

const structuredData = [
  {
    type: 'FAQPage' as const,
    data: {
      questions: faqs.map(({ title, description }) => ({ question: title, answer: description })),
    },
  },
];
---

<Layout metadata={metadata} structuredData={structuredData}>
  <!-- Hero Widget ******************* -->

  <Hero2
    tagline="The nomad's sketchbook · Est. 2025"
    stamp="Web App First — iOS & Android Coming Soon"
    pins={[
      {
        src: '~/assets/images/auvers-sur-oise.jpg',
        alt: 'Auvers-sur-Oise, France',
        label: 'Auvers-sur-Oise',
        coords: '49.07°N 2.17°E',
        top: 17,
        left: 65,
      },
      {
        src: '~/assets/images/taj-mahal.webp',
        alt: 'Morning Mist in Taj Mahal, woodblock print by Hiroshi Yoshida',
        label: 'Taj Mahal, Agra',
        coords: '27.17°N 78.04°E',
        top: 50,
        left: 91,
      },
      {
        label: 'Pin Your Sketch',
        top: 70,
        left: 15,
        placeholder: true,
      },
    ]}
    actions={[
      {
        variant: 'primary',
        text: 'Open Web App',
        href: 'https://sketchnomad.app',
        target: '_blank',
        icon: 'tabler:external-link',
      },
      {
        variant: 'secondary',
        text: 'Explore Features',
        href: '#features',
      },
    ]}
  >
    <Fragment slot="title">
      Sketch Nomad<br class="hidden sm:block" />
    </Fragment>

    <Fragment slot="title">
      <br class="p-0 m-0 sm:hidden" />
      <span class="text-2xl sm:text-3xl lg:text-4xl text-muted font-normal">
        The platform for <span id="animated-text" class="text-primary font-bold">Urban Sketchers</span>
      </span>
      <span class="sr-only">
        urban sketchers, plein air painters, outdoor artists, travel sketchers, and nature journalers
      </span>
    </Fragment>

    <Fragment slot="subtitle">
      Track plein air and pleinair adventures, pin urban sketches to a street corner, and keep a map of every place a
      travel sketcher draws. Share location-tagged artwork with outdoor artists worldwide.
    </Fragment>
  </Hero2>

  <Features
    id="who-its-for"
    tagline="Who it's for"
    title="Built for Artists Who Work Outdoors"
    subtitle="Whether you sketch cities, paint landscapes, or draw on the road, Sketch Nomad is a home for your outdoor practice."
    columns={2}
    items={[
      {
        title: 'Urban Sketchers',
        description:
          'Draw streets, cafés, and city life on location. Pin each urban sketch to the spot and find sketch-together sessions nearby.',
        icon: 'tabler:building',
      },
      {
        title: 'Plein Air Painters',
        description:
          'Capture light in the open air. Discover pleinair painting spots, log field notes, and meet other outdoor painters.',
        icon: 'tabler:palette',
        callToAction: { text: 'Plein air hub', href: getPermalink('/plein-air-hub') },
      },
      {
        title: 'Outdoor Artists',
        description:
          'From landscape painters to nature journalers — a quiet community for anyone who creates outside the studio.',
        icon: 'tabler:sun',
        callToAction: { text: 'Plein air resources', href: getPermalink('/plein-air-hub') },
      },
      {
        title: 'Travel Sketchers',
        description:
          'Turn every trip into a visual journal. Tag sketches to cities, trails, and landmarks as you go.',
        icon: 'tabler:plane',
      },
    ]}
  />

  <!-- Features Widget *************** -->
  <FeatureCards
    id="features"
    tagline="What's in the sketchbook"
    title="What's Here Now & What's Coming Next"
    subtitle="Explore our current features and get excited about the innovative tools we're building for the outdoor art community."
    classes={{ container: 'max-w-6xl' }}
    items={[
      {
        category: 'Location',
        title: 'GPS Location Tagging',
        description:
          'Tag your artwork with precise GPS coordinates, helping fellow artists discover and visit the exact scenic locations where your masterpieces were created.',
        icon: 'tabler:map-pin',
      },
      {
        category: 'Community',
        title: 'Global Artist Community',
        description:
          'Share your outdoor sketches and paintings with artists worldwide, and explore stunning artwork from creators across the globe.',
        icon: 'tabler:photo',
      },
      {
        category: 'Discovery',
        title: 'Interactive Discovery Maps',
        description:
          'Find new painting locations through our interactive mapping system, perfect for artists seeking fresh inspiration and scenic spots.',
        icon: 'tabler:map-2',
      },
      {
        category: 'Community',
        title: 'Sketch Together Sessions',
        description:
          'Host or join live plein air sketch sessions with fellow artists — set a time and place, then create side by side with sketch nomads near you.',
        icon: 'tabler:users-group',
      },
      {
        category: 'Roadmap',
        title: 'Much More Coming Soon',
        description:
          'Weather integration, art supply recommendations, skill-building tutorials, augmented reality features, and more tools built for outdoor artists.',
        icon: 'tabler:stars',
        status: 'soon',
        callToAction: {
          text: 'View the roadmap',
          href: '/roadmap',
          icon: 'tabler:arrow-right',
        },
      },
    ]}
  >
    <Fragment slot="bg">
      <div class="absolute inset-0 bg-surface/40 dark:bg-surface/20" aria-hidden="true"></div>
    </Fragment>
  </FeatureCards>
  <!-- HighlightedPosts Widget ******* -->

  <BlogLatestPosts
    title="Discover the World of Outdoor Art"
    information={`Explore our blog featuring art history, artist spotlights, and community events.
          Learn about painting traditions, discover works from renowned outdoor artists,
          and find featured sketches from breathtaking locations worldwide.
        `}
  />

  <!-- FAQs Widget ******************* -->
  <FAQs
    title="A Few Common Questions"
    subtitle="Here are some answers to questions we often hear. If you have others, please feel free to reach out."
    tagline="FAQs"
    classes={{ container: 'max-w-6xl' }}
    items={faqs}
  />
</Layout>

<script>
  document.addEventListener('DOMContentLoaded', function () {
    const artistTypes = [
      'Nature Journalers',
      'Outdoor Artists',
      'Plein Air Painters',
      'Travel Sketchers',
      'Sketch Nomads',
      'Urban Sketchers',
    ];

    let currentIndex = 0;
    const textElement = document.getElementById('animated-text');

    if (!textElement) {
      console.error('Animated text element not found');
      return;
    }

    function changeText() {
      if (!textElement) return;

      // Fade out
      textElement.style.opacity = '0';
      textElement.style.transform = 'translateY(10px)';

      setTimeout(() => {
        if (!textElement) return;

        // Change text
        currentIndex = (currentIndex + 1) % artistTypes.length;
        textElement.textContent = artistTypes[currentIndex];

        // Fade in
        textElement.style.opacity = '1';
        textElement.style.transform = 'translateY(0)';
      }, 300);
    }

    // Add CSS for smooth transitions
    textElement.style.transition = 'all 0.3s ease-in-out';

    // Start animation after initial delay
    setTimeout(() => {
      setInterval(changeText, 2500);
    }, 2000);
  });
</script>
