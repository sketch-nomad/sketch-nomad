---
import Layout from '~/layouts/Layout.astro';
import Header from '~/components/widgets/Header.astro';
import Footer from '~/components/widgets/Footer.astro';

import { headerData, footerData } from '~/navigation';

import type { MetaData } from '~/types';
import type { Props as StructuredDataProps } from '~/components/common/StructuredData.astro';

export interface Props {
  metadata?: MetaData;
  structuredData?: Array<StructuredDataProps>;
}

const { metadata, structuredData } = Astro.props;
---

<Layout metadata={metadata} structuredData={structuredData}>
  <slot name="header">
    <Header {...headerData} isSticky showToggleTheme position='left' />
  </slot>
  <main>
    <slot />
  </main>
  <slot name="footer">
    <Footer {...footerData} />
  </slot>
</Layout>
