---
import { SITE } from 'astrowind:config';
import Image from '~/components/common/Image.astro';
import logoMark from '~/assets/images/logo-mark.webp';
---

<span class="inline-flex items-center gap-2 self-center whitespace-nowrap">
  <Image
    src={logoMark}
    alt=""
    width={36}
    height={36}
    widths={[36, 72]}
    layout="fixed"
    loading="eager"
    class="dark:invert"
  />
  <span class="text-xl font-heading font-bold tracking-tight text-heading">{SITE?.name}</span>
</span>
