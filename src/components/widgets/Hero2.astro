---
import Button from '~/components/ui/Button.astro';
import GlobeScene from '~/components/ui/GlobeScene.astro';
import { Icon } from 'astro-icon/components';
import type { Hero as HeroProps } from '~/types';
import type { GlobePainting } from '~/data/globe-paintings';

export interface Props extends HeroProps {
  pins?: GlobePainting[];
  stamp?: string;
}

const {
  title = await Astro.slots.render('title'),
  subtitle = await Astro.slots.render('subtitle'),

  content = await Astro.slots.render('content'),
  actions = await Astro.slots.render('actions'),

  pins = [],
  stamp,

  id,
} = Astro.props;
---

<section
  class="relative isolate overflow-hidden bg-space not-prose md:-mt-[5.25rem] lg:min-h-[100svh]"
  {...id ? { id } : {}}
>
  <div class="starfield absolute inset-0 -z-[1] pointer-events-none" aria-hidden="true"></div>

  <div
    class="relative mx-auto max-w-7xl px-4 pb-6 pt-6 sm:px-6 md:pt-28 lg:flex lg:min-h-[100svh] lg:items-center lg:pb-16"
  >
    <div class="glass-panel relative z-10 w-full p-6 sm:p-10 lg:max-w-[35rem] lg:p-11">
      {
        title && (
          <h1 class="font-heading text-[clamp(2.75rem,6.4vw,4.75rem)] font-extrabold leading-[0.98] tracking-[-0.035em]">
            <Fragment set:html={title} />
          </h1>
        )
      }
      {subtitle && <p class="mt-5 text-lg leading-relaxed text-glass-muted md:text-[1.15rem]" set:html={subtitle} />}

      {
        actions && (
          <div class="mt-8 flex flex-col gap-3 sm:flex-row sm:items-center">
            {Array.isArray(actions) ? (
              actions.map((action) => (
                <div class="flex w-full sm:w-auto">
                  <Button {...(action || {})} class="w-full sm:mb-0" />
                </div>
              ))
            ) : (
              <Fragment set:html={actions} />
            )}
          </div>
        )
      }

      {
        stamp && (
          <p class="mt-5 inline-flex items-center gap-2 text-sm text-glass-muted">
            <Icon name="tabler:map-pin" class="h-4 w-4 text-primary" />
            {stamp}
          </p>
        )
      }
      {content && <Fragment set:html={content} />}
    </div>

    {pins.length > 0 && <GlobeScene paintings={pins} />}
  </div>
</section>
