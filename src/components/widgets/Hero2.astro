---
import Button from '~/components/ui/Button.astro';
import Image from '~/components/common/Image.astro';
import { Icon } from 'astro-icon/components';
import worldMapRaw from '~/assets/images/world-continents.svg?raw';

import type { Hero as HeroProps } from '~/types';

// Public-domain continent silhouette (CIA World Factbook, via Wikimedia Commons) used as a
// faint backdrop on the corkboard. Strip the XML prolog/metadata so it can be inlined in HTML,
// and let it fill its container instead of the source file's fixed pt dimensions.
const worldMap = worldMapRaw
  .replace(/<\?xml[^>]*\?>\s*/, '')
  .replace(/<metadata>[\s\S]*?<\/metadata>\s*/, '')
  .replace(/width="468pt"\s+height="239pt"/, 'width="100%" height="100%"')
  .replace(/preserveAspectRatio="xMidYMid meet"/, 'preserveAspectRatio="xMidYMid slice"');

export interface PinItem {
  src?: string;
  alt?: string;
  label: string;
  coords?: string;
  top: number;
  left: number;
  placeholder?: boolean;
}

export interface Props extends HeroProps {
  pins?: PinItem[];
  stamp?: string;
}

const {
  title = await Astro.slots.render('title'),
  subtitle = await Astro.slots.render('subtitle'),
  tagline,

  content = await Astro.slots.render('content'),
  actions = await Astro.slots.render('actions'),

  pins = [],
  stamp,

  id,
} = Astro.props;

// Build a dashed route connecting the pin coordinates for the corkboard SVG.
const routeD =
  pins.length > 1 ? pins.map((p, i) => `${i === 0 ? 'M' : 'L'} ${p.left},${p.top}`).join(' ') : '';
---

<section class="relative md:-mt-[76px] not-prose overflow-hidden" {...id ? { id } : {}}>
  <div class="absolute inset-0 pointer-events-none bg-page" aria-hidden="true"></div>
  <div class="relative max-w-7xl mx-auto px-4 sm:px-6">
    <div class="pt-0 md:pt-[76px] pointer-events-none"></div>
    <div class="py-12 md:py-20 lg:py-0 lg:grid lg:grid-cols-2 lg:items-center lg:min-h-screen lg:gap-12">
      <div class="text-center lg:text-left pb-10 md:pb-16 mx-auto lg:mx-0 max-w-2xl">
        {
          tagline && (
            <p class="font-mono-label text-xs text-primary font-semibold uppercase mb-4 intersect-once motion-safe:md:intersect:animate-fade motion-safe:md:opacity-0 intersect-quarter">
              <span set:html={tagline} />
            </p>
          )
        }
        {
          title && (
            <h1
              class="text-5xl md:text-6xl font-bold leading-[1.05] mb-5 font-heading text-heading intersect-once motion-safe:md:intersect:animate-fade motion-safe:md:opacity-0 intersect-quarter"
              set:html={title}
            />
          )
        }
        <div class="max-w-xl mx-auto lg:max-w-none">
          {
            subtitle && (
              <p
                class="text-lg md:text-xl text-muted mb-8 intersect-once motion-safe:md:intersect:animate-fade motion-safe:md:opacity-0 intersect-quarter"
                set:html={subtitle}
              />
            )
          }

          {
            actions && (
              <div class="max-w-xs sm:max-w-md m-auto flex flex-nowrap flex-col sm:flex-row sm:justify-center gap-4 lg:justify-start lg:m-0 lg:max-w-7xl intersect-once motion-safe:md:intersect:animate-fade motion-safe:md:opacity-0 intersect-quarter">
                {Array.isArray(actions) ? (
                  actions.map((action) => (
                    <div class="flex w-full sm:w-auto">
                      <Button {...(action || {})} class="w-full sm:mb-0" />
                    </div>
                  ))
                ) : (
                  <Fragment set:html={actions} />
                )}
              </div>
            )
          }

          {
            stamp && (
              <div class="mt-8 inline-flex items-center gap-2 font-mono-label text-xs text-muted border border-edge rounded-full px-3 py-1.5 intersect-once motion-safe:md:intersect:animate-fade motion-safe:md:opacity-0 intersect-quarter">
                <Icon name="tabler:map-pin" class="w-3.5 h-3.5 text-primary" />
                {stamp}
              </div>
            )
          }
        </div>
        {content && <Fragment set:html={content} />}
      </div>

      <div class="relative mt-12 lg:mt-0">
        {
          pins.length > 0 && (
            <div
              class="corkboard relative mx-auto max-w-lg aspect-[6/5] rounded-sm border border-edge bg-surface shadow-sm intersect-once intercept-no-queue motion-safe:md:intersect:animate-fade motion-safe:md:opacity-0 intersect-quarter"
              style="transform: rotate(-0.8deg);"
              aria-hidden="true"
            >
              {/* Single shared inset frame so the map, route line, and pins all use the same 0-100% coordinate box. */}
              <div class="absolute inset-6">
                <div class="absolute inset-0 overflow-hidden">
                  <div
                    class="world-map-bg absolute inset-0 text-accent/[0.16]"
                    style="transform: scale(1.4); transform-origin: 50% 50%;"
                    set:html={worldMap}
                  />
                </div>

                {routeD && (
                  <svg class="absolute inset-0 w-full h-full overflow-visible" viewBox="0 0 100 100" preserveAspectRatio="none">
                    <path
                      d={routeD}
                      fill="none"
                      stroke="rgb(var(--aw-color-accent))"
                      stroke-width="0.6"
                      stroke-linecap="round"
                      stroke-dasharray="1.5 3"
                      vector-effect="non-scaling-stroke"
                      opacity="0.55"
                    />
                  </svg>
                )}

                {pins.map((pin, i) => (
                  <div
                    class="absolute flex flex-col items-center"
                    style={`left:${pin.left}%; top:${pin.top}%; transform: translate(-50%, -35%);`}
                  >
                    <Icon name="tabler:map-pin-filled" class="w-5 h-5 text-primary drop-shadow-sm -mb-1 z-10" />
                    {pin.placeholder ? (
                      <div
                        class="w-28 sm:w-32 border-2 border-dashed border-edge rounded-sm bg-page/40 flex flex-col items-center justify-center py-6 px-2 text-center"
                        style={`transform: rotate(${i % 2 === 0 ? '2deg' : '-2deg'});`}
                      >
                        <Icon name="tabler:plus" class="w-5 h-5 text-muted mb-1" />
                        <span class="font-mono-label text-[0.6rem] uppercase text-muted leading-tight">{pin.label}</span>
                      </div>
                    ) : (
                      <div
                        class="w-32 sm:w-36 bg-page p-1.5 pb-2 rounded-sm shadow-md"
                        style={`transform: rotate(${i % 2 === 0 ? '-2deg' : '2deg'});`}
                      >
                        <div class="overflow-hidden rounded-[1px]">
                          <Image
                            src={pin.src}
                            alt={pin.alt || pin.label}
                            widths={[144, 288]}
                            width={144}
                            height={96}
                            layout="cover"
                            loading="lazy"
                            decoding="async"
                            class="w-full h-20 sm:h-24 object-cover"
                          />
                        </div>
                        <div class="font-mono-label text-[0.6rem] uppercase text-default text-center mt-1.5 leading-tight">
                          {pin.label}
                        </div>
                        {pin.coords && (
                          <div class="font-mono-label text-[0.55rem] text-muted text-center leading-tight">
                            {pin.coords}
                          </div>
                        )}
                    </div>
                  )}
                </div>
              ))}
              </div>
            </div>
          )
        }
      </div>
    </div>
  </div>
</section>
