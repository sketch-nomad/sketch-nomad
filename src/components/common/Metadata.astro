---
import { SITE, METADATA, I18N } from '~/config';
import type { MetaData } from '~/types';
import { getCanonical } from '~/utils/permalinks';
import { adaptOpenGraphImages } from '~/utils/images';

export interface Props extends MetaData {
  dontUseTitleTemplate?: boolean;
}

const {
  title,
  ignoreTitleTemplate = false,
  canonical = String(getCanonical(String(Astro.url.pathname))),
  robots = {},
  description = METADATA.description,
  keywords,
  openGraph = {},
  twitter = {},
} = Astro.props;

const fullTitle = !title
  ? (METADATA.title?.default ?? SITE.name)
  : ignoreTitleTemplate
    ? title
    : (METADATA.title?.template ?? '%s').replace('%s', title);

const index = robots.index ?? METADATA.robots?.index ?? false;
const follow = robots.follow ?? METADATA.robots?.follow ?? false;

const og = await adaptOpenGraphImages(
  {
    ...METADATA.openGraph,
    ...openGraph,
    images: openGraph.images?.length ? openGraph.images : METADATA.openGraph?.images,
  },
  Astro.site
);
const image = og.images?.find((img) => img.url);
const siteName = og.site_name ?? SITE.name;
const twitterCard = twitter.cardType ?? (image ? 'summary_large_image' : 'summary');
---

<title>{fullTitle}</title>
{description && <meta name="description" content={description} />}
{keywords && <meta name="keywords" content={keywords} />}
<meta name="robots" content={`${index ? 'index' : 'noindex'},${follow ? 'follow' : 'nofollow'}`} />
<link rel="canonical" href={canonical} />

<meta property="og:title" content={title ?? fullTitle} />
{description && <meta property="og:description" content={description} />}
<meta property="og:url" content={canonical} />
<meta property="og:type" content={og.type ?? 'website'} />
{
  image && (
    <>
      <meta property="og:image" content={image.url} />
      {image.width && <meta property="og:image:width" content={String(image.width)} />}
      {image.height && <meta property="og:image:height" content={String(image.height)} />}
    </>
  )
}
<meta property="og:locale" content={og.locale ?? I18N.language} />
<meta property="og:site_name" content={siteName} />

<meta name="twitter:card" content={twitterCard} />
{twitter.handle && <meta name="twitter:creator" content={twitter.handle} />}
{twitter.site && <meta name="twitter:site" content={twitter.site} />}
