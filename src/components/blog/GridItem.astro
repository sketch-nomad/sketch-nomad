---
import { APP_BLOG } from '~/config';
import type { Post } from '~/types';

import Image from '~/components/common/Image.astro';

import { findImage } from '~/utils/images';
import { getPermalink } from '~/utils/permalinks';

export interface Props {
  post: Post;
  /** First item in a list: it is usually the LCP image, so load it eagerly. */
  priority?: boolean;
}

const { post, priority = false } = Astro.props;
const image = await findImage(post.image);

const link = APP_BLOG?.post?.isEnabled ? getPermalink(post.permalink, 'post') : '';
---

<article class="list-panel mb-6 p-3 sm:p-4">
  <div class="relative w-full h-48 sm:h-56 md:h-64 overflow-hidden bg-page rounded-2xl mb-5">
    {
      image &&
        (link ? (
          <a class="block w-full h-full" href={link}>
            <Image
              src={image}
              class="w-full h-full object-cover"
              widths={[400, 600]}
              width={600}
              sizes="(min-width: 1024px) 300px, (min-width: 768px) 350px, 400px"
              alt={post.title}
              layout="cover"
              loading={priority ? 'eager' : 'lazy'}
              fetchpriority={priority ? 'high' : undefined}
              decoding="async"
            />
          </a>
        ) : (
          <Image
            src={image}
            class="w-full h-full object-cover"
            widths={[400, 600]}
            width={600}
            sizes="(min-width: 1024px) 300px, (min-width: 768px) 350px, 400px"
            alt={post.title}
            layout="cover"
            loading={priority ? 'eager' : 'lazy'}
            fetchpriority={priority ? 'high' : undefined}
            decoding="async"
          />
        ))
    }
  </div>

  <h3 class="text-xl sm:text-2xl font-bold leading-tight mb-2 text-heading font-heading">
    {
      link ? (
        <a class="inline-block underline-offset-4 hover:underline transition ease-in duration-200" href={link}>
          {post.title}
        </a>
      ) : (
        post.title
      )
    }
  </h3>

  <p class="text-lg leading-snug text-muted">{post.excerpt}</p>
</article>
